# OPTIONAL HTTPS
# This file is ignored by nginx until it is renamed to ssl.conf.
# Run build/mkcert.sh, which creates the certificates and this ssl.conf for you.
server {
    listen 443 ssl;

    server_name dhbw.test localhost;

    ssl_certificate     /etc/nginx/conf.d/app.crt;
    ssl_certificate_key /etc/nginx/conf.d/app.key;

    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;

    # Allow bigger uploads
    client_max_body_size 64M;

    index index.php index.html;
    root /application;

    location / {
        # serve request as file, then as directory, otherwise 404
        try_files $uri $uri/ =404;

        # allow directory listing
        autoindex on;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        # resolve "php" on every request, so a recreated php container is found again
        resolver 127.0.0.11 valid=10s;
        set $php_upstream php:9000;
        fastcgi_pass $php_upstream;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS on;
    }

    location ~ /\.ht {
       deny all;
    }
}
